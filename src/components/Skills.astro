---

<section id="skills" class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-16" id="skills-header">
            <p
                class="text-secondary text-sm font-medium tracking-widest uppercase mb-3"
            >
                Tecnologías
            </p>
            <h2 class="text-4xl md:text-5xl font-extrabold text-white">
                Mi <span
                    class="text-transparent bg-clip-text bg-linear-to-r from-primary to-secondary"
                    >Stack</span
                >
            </h2>
            <p class="text-muted mt-4 max-w-md mx-auto">
                Herramientas y tecnologías con las que construyo soluciones del
                mundo real.
            </p>
        </div>

        <!-- Grid de skills -->
        <div
            class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-4"
            id="skills-grid"
        >
            {
                skills.map((skill, i) => (
                    <div
                        class="skill-card group flex flex-col items-center gap-3 p-5 rounded-2xl
                 bg-surface border border-white/5 hover:border-primary/40
                 hover:bg-primary/5 transition-all duration-300 cursor-default"
                        data-index={i}
                    >
                        <div class="w-12 h-12 transition-transform duration-300 group-hover:scale-110">
                            <Fragment set:html={skill.icon} />
                        </div>
                        <span class="text-muted group-hover:text-white text-xs font-medium text-center transition-colors duration-300">
                            {skill.name}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        // Header animado
        gsap.fromTo(
            "#skills-header",
            { opacity: 0, y: 40 },
            {
                opacity: 1,
                y: 0,
                duration: 0.7,
                ease: "power3.out",
                scrollTrigger: { trigger: "#skills-header", start: "top 85%" },
            },
        );

        // Cards escalonadas
        gsap.fromTo(
            ".skill-card",
            { opacity: 0, y: 30, scale: 0.9 },
            {
                opacity: 1,
                y: 0,
                scale: 1,
                duration: 0.4,
                ease: "back.out(1.7)",
                stagger: 0.06,
                scrollTrigger: { trigger: "#skills-grid", start: "top 80%" },
            },
        );
    });
</script>
