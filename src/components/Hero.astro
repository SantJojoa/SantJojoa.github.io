---
const socialLinks = [
    {
        label: "GitHub",
        href: "#",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>`,
    },
    {
        label: "LinkedIn",
        href: "#",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    },
    {
        label: "Computrabajo",
        href: "#",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M20 6h-1V4c0-1.1-.9-2-2-2H7C5.9 2 5 2.9 5 4v2H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zM7 4h10v2H7V4zm13 15H4V8h16v11z"/><path d="M11 10h2v2h-2zm-4 0h2v2H7zm8 0h2v2h-2z"/></svg>`,
    },
];
---

<section id="home" class="min-h-screen flex items-center pt-20 px-6">
    <div
        class="max-w-6xl mx-auto w-full grid md:grid-cols-2 gap-12 items-center"
    >
        <!-- Texto -->
        <div id="hero-text" class="flex flex-col gap-6">
            <div id="hero-badge" class="flex items-center gap-2 w-fit">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"
                ></span>
                <span
                    class="text-secondary text-sm font-medium tracking-widest uppercase"
                    >Disponible para trabajar</span
                >
            </div>

            <div>
                <p id="hero-greeting" class="text-muted text-lg mb-2">
                    Hola, soy
                </p>
                <h1
                    id="hero-name"
                    class="text-5xl md:text-7xl font-extrabold leading-tight tracking-tight"
                >
                    Santiago<br />
                    <span
                        class="text-transparent bg-clip-text bg-linear-to-r from-primary to-secondary"
                    >
                        Jojoa
                    </span>
                </h1>
            </div>

            <p
                id="hero-role"
                class="text-2xl md:text-3xl font-semibold text-muted"
            >
                Full Stack Developer
            </p>

            <p id="hero-desc" class="text-muted leading-relaxed max-w-md">
                Apasionado por construir aplicaciones web modernas, escalables y
                con experiencias de usuario excepcionales. Transformo ideas en
                productos digitales reales.
            </p>

            <!-- Links sociales -->
            <div id="hero-links" class="flex items-center gap-4 flex-wrap">
                {
                    socialLinks.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={link.label}
                            class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-white/10 bg-surface
                text-muted hover:text-white hover:border-primary hover:bg-primary/10
                transition-all duration-300 text-sm font-medium group"
                        >
                            <span
                                class="group-hover:text-primary transition-colors"
                                set:html={link.icon}
                            />
                            {link.label}
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Foto -->
        <div id="hero-image" class="flex justify-center md:justify-end">
            <div class="relative">
                <!-- Anillo decorativo -->
                <div
                    class="absolute inset-0 rounded-full bg-linear-to-br from-primary to-secondary blur-2xl opacity-20 scale-110"
                >
                </div>

                <!-- Placeholder foto -->
                <div
                    class="relative w-72 h-72 md:w-80 md:h-80 rounded-full border-2 border-primary/30
                    bg-surface flex flex-col items-center justify-center gap-3 overflow-hidden"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-24 h-24 text-muted/40"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"
                        ></path>
                    </svg>
                    <span class="text-muted/60 text-xs font-medium">
                        <img src="photo.JPEG" alt="" />
                    </span>
                </div>

                <!-- Tarjeta flotante -->
                <div
                    id="float-card"
                    class="absolute -bottom-4 -left-4 bg-surface border border-white/10
                    rounded-2xl px-4 py-3 flex items-center gap-3 shadow-xl"
                >
                    <div
                        class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4 text-primary"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                            ></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-white text-xs font-semibold">
                            Full Stack
                        </p>
                        <p class="text-muted text-xs">Web Developer</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        const tl = gsap.timeline({ delay: 0.8 });

        tl.fromTo(
            "#hero-badge",
            { opacity: 0, y: 20 },
            { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" },
        )
            .fromTo(
                "#hero-greeting",
                { opacity: 0, x: -30 },
                { opacity: 1, x: 0, duration: 0.5, ease: "power3.out" },
                "-=0.2",
            )
            .fromTo(
                "#hero-name",
                { opacity: 0, x: -30 },
                { opacity: 1, x: 0, duration: 0.6, ease: "power3.out" },
                "-=0.3",
            )
            .fromTo(
                "#hero-role",
                { opacity: 0, x: -30 },
                { opacity: 1, x: 0, duration: 0.5, ease: "power3.out" },
                "-=0.3",
            )
            .fromTo(
                "#hero-desc",
                { opacity: 0, y: 20 },
                { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" },
                "-=0.2",
            )
            .fromTo(
                "#hero-links",
                { opacity: 0, y: 20 },
                { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" },
                "-=0.2",
            )
            .fromTo(
                "#hero-image",
                { opacity: 0, scale: 0.8 },
                { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.4)" },
                "-=0.8",
            );

        // Flotación suave de la tarjeta
        gsap.to("#float-card", {
            y: -8,
            duration: 2,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });
    });
</script>
