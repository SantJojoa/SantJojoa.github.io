---
const projects = [
  {
    title: 'SIVAT Nariño',
    description:
      'Plataforma para llevar registro de programaciones de todas las subdirecciones del Instituto Departamental de Nariño. Incluye validación de cruces en programaciones, aprobación/rechazo según rol, adherencia a programaciones y control por roles.',
    tags: ['PHP', 'MySQL', 'JavaScript'],
    repo: null,
    demo: null,
    featured: false,
  },
  {
    title: 'SINSI Nariño',
    description:
      'Plataforma para el control de la salud infantil de cada municipio del departamento de Nariño. Permite el seguimiento centralizado de indicadores de salud infantil a nivel departamental.',
    tags: ['PHP', 'MySQL', 'JavaScript'],
    repo: null,
    demo: null,
    featured: false,
  },
  {
    title: 'FEVRIPS',
    description:
      'Plataforma para validar RIPS de IPS integrando la API privada del Ministerio de Salud de Nariño. Incluye validación de facturas en JSON y comparación de datos del ministerio con datos locales.',
    tags: ['PHP', 'MySQL', 'Node.js', 'REST API'],
    repo: null,
    demo: null,
    featured: false,
  },
  {
    title: 'Juventud Conecta',
    description:
      'Plataforma web para potenciar la visibilidad y participación de jóvenes en eventos sociales de alto impacto en Pasto, Colombia. Permite acceder a información de eventos, registrarse y conectar con iniciativas comunitarias.',
    tags: ['React', 'TypeScript', 'Tailwind'],
    repo: 'https://github.com/SantJojoa/juventud-conecta',
    demo: null,
    featured: false,
  },
  {
    title: 'Finance Sheets Auto Bot',
    description:
      'Bot que automatiza atajos de iPhone para registrar ingresos y egresos en Google Sheets. Incluye listas organizadas, gráficas, registro de deudas y análisis financiero personal automatizado.',
    tags: ['JavaScript', 'Node.js', 'Google Sheets API'],
    repo: null,
    demo: null,
    featured: false,
  },
  {
    title: 'Monely',
    description:
      'Personal finance tracker con gestión de gastos e ingresos, categorías, métodos de pago, gráficas interactivas e integración con bot de Telegram para registros rápidos desde cualquier lugar.',
    tags: ['React', 'TypeScript', 'Tailwind', 'Supabase', 'Prisma'],
    repo: null,
    demo: 'https://monely.vercel.app/',
    featured: true,
  },
];
---

<section id="projects" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-16" id="projects-header">
      <p class="text-secondary text-sm font-medium tracking-widest uppercase mb-3">Mi trabajo</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white">
        Proyectos <span class="text-transparent bg-clip-text bg-linear-to-r from-primary to-secondary">Destacados</span>
      </h2>
      <p class="text-muted mt-4 max-w-md mx-auto">
        Soluciones reales que he construido, desde plataformas institucionales hasta aplicaciones personales.
      </p>
    </div>

    <!-- Grid de proyectos -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
      {projects.map((project, i) => (
        <div
          class={`project-card group relative flex flex-col gap-4 p-6 rounded-2xl border
                  transition-all duration-300 hover:-translate-y-1 hover:shadow-xl
                  ${project.featured
                    ? 'bg-primary/10 border-primary/30 hover:border-primary/60 hover:shadow-primary/10'
                    : 'bg-surface border-white/5 hover:border-primary/30 hover:shadow-primary/5'
                  }`}
          data-index={i}
        >
          <!-- Featured badge -->
          {project.featured && (
            <div class="absolute -top-3 left-6">
              <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary text-white text-xs font-semibold shadow-lg shadow-primary/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                Destacado
              </span>
            </div>
          )}

          <!-- Icono del proyecto -->
          <div class={`w-12 h-12 rounded-xl flex items-center justify-center
                       ${project.featured ? 'bg-primary/20' : 'bg-white/5'}
                       group-hover:scale-110 transition-transform duration-300`}>
            <svg xmlns="http://www.w3.org/2000/svg" class={`w-6 h-6 ${project.featured ? 'text-primary' : 'text-muted'}`}
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/>
            </svg>
          </div>

          <!-- Título y descripción -->
          <div class="flex flex-col gap-2 flex-1">
            <h3 class="text-white font-bold text-lg group-hover:text-primary transition-colors duration-300">
              {project.title}
            </h3>
            <p class="text-muted text-sm leading-relaxed flex-1">
              {project.description}
            </p>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2">
            {project.tags.map(tag => (
              <span class="px-2.5 py-1 rounded-lg bg-white/5 border border-white/5
                           text-muted text-xs font-medium">
                {tag}
              </span>
            ))}
          </div>

          <!-- Links -->
          {(project.repo || project.demo) && (
            <div class="flex items-center gap-3 pt-2 border-t border-white/5">
              {project.repo && (
                
                  <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-muted hover:text-white text-xs
                         font-medium transition-colors duration-200"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                  Repositorio
                </a>
              )}
              {project.demo && (
                
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1.5 text-secondary hover:text-white text-xs
                         font-medium transition-colors duration-200 ml-auto"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                       stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  Ver demo
                </a>
              )}
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {

    gsap.fromTo('#projects-header',
      { opacity: 0, y: 40 },
      {
        opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
        scrollTrigger: { trigger: '#projects-header', start: 'top 85%' }
      }
    );

    gsap.fromTo('.project-card',
      { opacity: 0, y: 40 },
      {
        opacity: 1, y: 0,
        duration: 0.5,
        ease: 'power3.out',
        stagger: 0.1,
        scrollTrigger: { trigger: '#projects-grid', start: 'top 80%' }
      }
    );
  });
</script>