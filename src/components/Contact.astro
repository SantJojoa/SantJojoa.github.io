---
const contactInfo = [
    {
        label: "Email",
        value: "tucorreo@email.com",
        href: "mailto:tucorreo@email.com",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
    </svg>`,
    },
    {
        label: "GitHub",
        value: "github.com/SantJojoa",
        href: "https://github.com/SantJojoa",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
    </svg>`,
    },
    {
        label: "LinkedIn",
        value: "linkedin.com/in/santiago-jojoa",
        href: "#",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
    </svg>`,
    },
    {
        label: "Computrabajo",
        value: "computrabajo.com",
        href: "#",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.073a2.25 2.25 0 01-2.25 2.25h-12a2.25 2.25 0 01-2.25-2.25V6a2.25 2.25 0 012.25-2.25h4.5M19.5 3.75h-6m6 0v6m0-6L12 12.75"/>
    </svg>`,
    },
];
---

<section id="contact" class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-16" id="contact-header">
            <p
                class="text-secondary text-sm font-medium tracking-widest uppercase mb-3"
            >
                Contacto
            </p>
            <h2 class="text-4xl md:text-5xl font-extrabold text-white">
                Hablemos <span
                    class="text-transparent bg-clip-text bg-linear-to-r from-primary to-secondary"
                    >✌️</span
                >
            </h2>
            <p class="text-muted mt-4 max-w-lg mx-auto">
                ¿Tienes un proyecto en mente o quieres trabajar juntos?
                Escríbeme, estoy disponible para nuevas oportunidades.
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-12 items-start">
            <!-- Info de contacto -->
            <div id="contact-info" class="flex flex-col gap-6">
                <div
                    class="p-6 rounded-2xl bg-surface border border-white/5 flex flex-col gap-5"
                >
                    {
                        contactInfo.map((item) => (
                            <a
                                href={item.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="contact-item flex items-center gap-4 group"
                            >
                                <div
                                    class="w-11 h-11 rounded-xl bg-white/5 border border-white/5
                          flex items-center justify-center text-muted shrink-0
                          group-hover:bg-primary/20 group-hover:border-primary/30
                          group-hover:text-primary transition-all duration-300"
                                >
                                    <Fragment set:html={item.icon} />
                                </div>
                                <div>
                                    <p class="text-muted text-xs mb-0.5">
                                        {item.label}
                                    </p>
                                    <p class="text-white text-sm font-medium group-hover:text-primary transition-colors duration-300">
                                        {item.value}
                                    </p>
                                </div>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 text-muted ml-auto opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-1 group-hover:translate-x-0"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M9 5l7 7-7 7"
                                    />
                                </svg>
                            </a>
                        ))
                    }
                </div>

                <!-- Disponibilidad -->
                <div
                    class="flex items-center gap-3 p-4 rounded-xl bg-secondary/10 border border-secondary/20"
                >
                    <span
                        class="w-2.5 h-2.5 rounded-full bg-secondary animate-pulse shrink-0"
                    ></span>
                    <p class="text-secondary text-sm font-medium">
                        Disponible para proyectos freelance y oportunidades
                        full-time
                    </p>
                </div>
            </div>

            <!-- Formulario -->
            <div id="contact-form">
                <form id="form" class="flex flex-col gap-5">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex flex-col gap-2">
                            <label
                                for="name"
                                class="text-muted text-xs font-medium uppercase tracking-wider"
                            >
                                Nombre
                            </label>
                            <input
                                id="name"
                                type="text"
                                placeholder="Tu nombre"
                                class="w-full px-4 py-3 rounded-xl bg-surface border border-white/10
                       text-white placeholder:text-muted/50 text-sm
                       focus:outline-none focus:border-primary/60 focus:bg-primary/5
                       transition-all duration-300"
                            />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label
                                for="email"
                                class="text-muted text-xs font-medium uppercase tracking-wider"
                            >
                                Email
                            </label>
                            <input
                                id="email"
                                type="email"
                                placeholder="tu@email.com"
                                class="w-full px-4 py-3 rounded-xl bg-surface border border-white/10
                       text-white placeholder:text-muted/50 text-sm
                       focus:outline-none focus:border-primary/60 focus:bg-primary/5
                       transition-all duration-300"
                            />
                        </div>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label
                            for="subject"
                            class="text-muted text-xs font-medium uppercase tracking-wider"
                        >
                            Asunto
                        </label>
                        <input
                            id="subject"
                            type="text"
                            placeholder="¿En qué te puedo ayudar?"
                            class="w-full px-4 py-3 rounded-xl bg-surface border border-white/10
                     text-white placeholder:text-muted/50 text-sm
                     focus:outline-none focus:border-primary/60 focus:bg-primary/5
                     transition-all duration-300"
                        />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label
                            for="message"
                            class="text-muted text-xs font-medium uppercase tracking-wider"
                        >
                            Mensaje
                        </label>
                        <textarea
                            id="message"
                            rows="5"
                            placeholder="Cuéntame sobre tu proyecto..."
                            class="w-full px-4 py-3 rounded-xl bg-surface border border-white/10
                     text-white placeholder:text-muted/50 text-sm resize-none
                     focus:outline-none focus:border-primary/60 focus:bg-primary/5
                     transition-all duration-300"
                        ></textarea>
                    </div>

                    <button
                        type="submit"
                        id="submit-btn"
                        class="group flex items-center justify-center gap-3 w-full py-3.5 rounded-xl
                   bg-primary hover:bg-primary/80 text-white font-semibold
                   transition-all duration-300 hover:shadow-lg hover:shadow-primary/25"
                    >
                        <span id="btn-text">Enviar mensaje</span>
                        <svg
                            id="btn-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                    </button>

                    <!-- Feedback -->
                    <div
                        id="form-feedback"
                        class="hidden text-center text-sm py-3 px-4 rounded-xl"
                    >
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer class="py-8 px-6 border-t border-white/5">
    <div
        class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4"
    >
        <p class="text-muted text-sm">
            © 2025 <span class="text-white font-medium">Santiago Jojoa</span>.
            Todos los derechos reservados.
        </p>
        <p class="text-muted text-sm flex items-center gap-1.5">
            Hecho con
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 text-red-500"
                fill="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                ></path>
            </svg>
            usando Astro, Tailwind & GSAP
        </p>
    </div>
</footer>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        gsap.fromTo(
            "#contact-header",
            { opacity: 0, y: 40 },
            {
                opacity: 1,
                y: 0,
                duration: 0.7,
                ease: "power3.out",
                scrollTrigger: { trigger: "#contact-header", start: "top 85%" },
            },
        );

        gsap.fromTo(
            "#contact-info",
            { opacity: 0, x: -40 },
            {
                opacity: 1,
                x: 0,
                duration: 0.7,
                ease: "power3.out",
                scrollTrigger: { trigger: "#contact-info", start: "top 80%" },
            },
        );

        gsap.fromTo(
            "#contact-form",
            { opacity: 0, x: 40 },
            {
                opacity: 1,
                x: 0,
                duration: 0.7,
                ease: "power3.out",
                scrollTrigger: { trigger: "#contact-form", start: "top 80%" },
            },
        );

        gsap.fromTo(
            ".contact-item",
            { opacity: 0, x: -20 },
            {
                opacity: 1,
                x: 0,
                duration: 0.4,
                ease: "power3.out",
                stagger: 0.1,
                scrollTrigger: { trigger: ".contact-item", start: "top 85%" },
            },
        );

        // Manejo del formulario — abre el cliente de correo
        const form = document.getElementById("form");
        const feedback = document.getElementById("form-feedback");
        const btnText = document.getElementById("btn-text");
        const btnIcon = document.getElementById("btn-icon");

        form?.addEventListener("submit", (e) => {
            e.preventDefault();

            const name = (
                document.getElementById("name") as HTMLInputElement
            ).value.trim();
            const email = (
                document.getElementById("email") as HTMLInputElement
            ).value.trim();
            const subject = (
                document.getElementById("subject") as HTMLInputElement
            ).value.trim();
            const message = (
                document.getElementById("message") as HTMLTextAreaElement
            ).value.trim();

            if (!name || !email || !subject || !message) {
                feedback!.className =
                    "text-center text-sm py-3 px-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400";
                feedback!.textContent = "Por favor completa todos los campos.";
                return;
            }

            const mailtoLink = `mailto:tucorreo@email.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(`Hola Santiago, soy ${name} (${email}).\n\n${message}`)}`;
            window.location.href = mailtoLink;

            feedback!.className =
                "text-center text-sm py-3 px-4 rounded-xl bg-secondary/10 border border-secondary/20 text-secondary";
            feedback!.textContent =
                "¡Gracias! Se abrió tu cliente de correo para enviar el mensaje.";

            (form as HTMLFormElement).reset();
        });
    });
</script>
